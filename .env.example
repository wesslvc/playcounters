# ---- Spotify (developer.spotify.com/dashboard) ----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match the Redirect URI registered in your Spotify app, exactly.
SPOTIFY_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback

# ---- Supabase (Project Settings → API) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
# Any long random string. Signs the login cookie.
SESSION_SECRET=
# Any long random string. GitHub Actions sends this to /api/sync.
CRON_SECRET=

# ---- newphoneprediction (OpenAI) ----
OPENAI_API_KEY=
# Optional. Defaults to OPENAI_MODEL, then the radio's model.
OPENAI_MODEL_PHONES=
# Optional cost knobs (see README): searchers' model, editor/judge model, reasoning effort per role,
# how much of each web page a search reads, and how long a researched phone is reused.
OPENAI_MODEL_PHONES_AGENTS=
OPENAI_MODEL_PHONES_HEAD=
PHONES_EFFORT_AGENTS=
PHONES_EFFORT_EDITOR=
PHONES_EFFORT_JUDGE=
PHONES_SEARCH_CONTEXT=
PHONES_TTL_HOURS=
PHONES_REFRESH_SECRET=
